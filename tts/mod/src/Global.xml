<!-- ======================== CARD LAYOUT EDITOR ====================== -->
<Panel id="cus_layout" active="false" width="440" height="430" rectAlignment="MiddleRight" offsetXY="-16 0">
  <VerticalLayout>
    <Text fontSize="18" color="#8fd0ff">Card Layout Editor</Text>
    <HorizontalLayout preferredHeight="30" spacing="4">
      <Button text="◀ Zone" onClick="clZonePrev"/>
      <Text id="cl_zone" alignment="MiddleCenter">Zone: name</Text>
      <Button text="Zone ▶" onClick="clZoneNext"/>
    </HorizontalLayout>
    <Text id="cl_info" fontSize="12" color="#cfe8ff">x y w h size</Text>
    <Text fontSize="12" color="#8899bb">Move (position)</Text>
    <HorizontalLayout preferredHeight="30" spacing="4">
      <Button text="X −" onClick="clXminus"/><Button text="X +" onClick="clXplus"/>
      <Button text="Y −" onClick="clYminus"/><Button text="Y +" onClick="clYplus"/>
    </HorizontalLayout>
    <Text fontSize="12" color="#8899bb">Size (box + font)</Text>
    <HorizontalLayout preferredHeight="30" spacing="4">
      <Button text="W −" onClick="clWminus"/><Button text="W +" onClick="clWplus"/>
      <Button text="H −" onClick="clHminus"/><Button text="H +" onClick="clHplus"/>
      <Button text="font −" onClick="clFminus"/><Button text="font +" onClick="clFplus"/>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" spacing="4">
      <Button text="Align" onClick="clAlign"/>
      <Button text="Show/Hide" onClick="clShow"/>
      <Button text="Apply to all cards" onClick="clApplyAll"/>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="30" spacing="4">
      <Button text="Export JSON → console" onClick="clExport"/>
    </HorizontalLayout>
    <InputField id="cl_import" placeholder="paste layout JSON here to import" onValueChanged="clImportChanged"/>
    <HorizontalLayout preferredHeight="30" spacing="4">
      <Button text="Import pasted JSON" onClick="clImport"/>
      <Button text="Close" color="#4a2530" onClick="clClose"/>
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<Panel id="cus_logpanel" active="false" width="520" height="300" rectAlignment="LowerRight" offsetXY="-12 12">
  <VerticalLayout>
    <Text fontSize="16" color="#8fd0ff">Action Log</Text>
    <VerticalScrollView preferredHeight="240" color="rgba(0,0,0,0.3)">
      <Text id="log_text" fontSize="13" alignment="UpperLeft"> </Text>
    </VerticalScrollView>
  </VerticalLayout>
</Panel>
